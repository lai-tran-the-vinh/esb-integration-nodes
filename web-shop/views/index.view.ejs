<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Mua hàng WSO2</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Config nhanh CDN cho đúng ý spacing 1px của mày
        tailwind.config = {
            theme: { extend: { spacing: { '10': '10px', '15': '15px', '20': '20px', '30': '30px', '400': '400px', '500': '500px' } } }
        }
    </script>
</head>

<body class="bg-gray-100 flex justify-center items-center h-screen">

    <div class="bg-white p-30 rounded-lg shadow-md w-500">
        <h1 class="text-xl font-bold mb-20 text-center">GIỎ HÀNG CỦA BẠN</h1>

        <div class="border-b pb-15 mb-15 flex justify-between">
            <div>
                <p class="font-semibold">
                    <%= product.name %>
                </p>
                <p class="text-gray-500 text-sm">Số lượng: <%= product.qty %>
                </p>
            </div>
            <p class="font-bold text-red-600">
                <%= product.price.toLocaleString() %> VND
            </p>
        </div>

        <form action="/checkout" method="POST" class="flex flex-col gap-15">
            <input type="hidden" name="product_id" value="<%= product.id %>">
            <input type="hidden" name="quantity" value="<%= product.qty %>">
            <div>
                <label class="block text-sm font-medium mb-10">Họ/Tên Khách Hàng:</label>
                <input type="text" name="customer_name" placeholder="Nhập họ và tên" required
                    class="border w-full p-10 rounded">
            </div>
            <div>
                <label class="block text-sm font-medium mb-10">Email:</label>
                <input type="email" name="customer_email" placeholder="Nhập email" required
                    class="border w-full p-10 rounded">
            </div>

            <button type="submit" class="bg-blue-600 text-white font-bold p-15 rounded hover:bg-blue-700 mt-10">
                THANH TOÁN VNPAY NGAY
            </button>
        </form>
    </div>

</body>

</html>