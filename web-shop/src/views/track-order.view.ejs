<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Tra cứu đơn hàng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } }
        }
    </script>
</head>

<body class="bg-gray-100 flex justify-center items-center min-h-screen font-sans text-gray-900 p-4">

    <div class="bg-white p-8 sm:p-10 rounded-xl w-full max-w-[500px]">
        <h1 class="text-2xl font-semibold mb-8 text-center tracking-tight">Tra cứu đơn hàng</h1>

        <form id="track-form" class="flex flex-col gap-6" onsubmit="trackOrder(event)">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Mã đơn hàng</label>
                <input type="text" id="order_id" name="order_id" placeholder="Nhập mã đơn hàng của bạn" required
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-black focus:border-black text-sm transition-colors">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                <input type="email" id="customer_email" name="customer_email" placeholder="Nhập địa chỉ email" required
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-black focus:border-black text-sm transition-colors">
            </div>

            <button type="submit" id="submit-btn"
                class="w-full bg-red-700 text-white py-3 rounded-md text-sm font-medium hover:bg-red-800 transition-colors flex justify-center items-center gap-2">
                <span>Tra cứu ngay</span>
                <svg id="loading-icon" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg"
                    fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                    </path>
                </svg>
            </button>

            <a href="/" class="text-center text-sm font-medium text-gray-500 hover:text-red-700 transition-colors mt-2">
                &larr; Quay lại cửa hàng
            </a>
        </form>

        <div id="result-container" class="mt-8 hidden border-t border-gray-100 pt-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Kết quả tra cứu</h3>
            <div id="result-content" class="bg-gray-50 p-5 rounded-md text-sm border border-gray-200"></div>
        </div>
    </div>

    <script>
        async function trackOrder(e) {
            e.preventDefault();
            const orderId = document.getElementById('order_id').value.trim();
            const email = document.getElementById('customer_email').value.trim();
            const btn = document.getElementById('submit-btn');
            const icon = document.getElementById('loading-icon');
            const resContainer = document.getElementById('result-container');
            const resContent = document.getElementById('result-content');

            // Hiển thị trạng thái loading
            btn.disabled = true;
            icon.classList.remove('hidden');
            resContainer.classList.add('hidden');
            resContent.innerHTML = '';

            try {
                const response = await fetch('/orders/track', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ order_id: parseInt(orderId, 10), email: email })
                });

                const data = await response.json();
                if (typeof data === 'string') {
                    data = JSON.parse(data);
                }
                if (!response.ok || data.status === 'error' || data.error) {
                    resContent.innerHTML = `<div class="text-red-600 font-medium">${data.error || data.message || 'Lỗi xử lý tra cứu'}</div>`;
                } else if (data.order) {
                    const order = data.order;
                    // Format Unix timestamp if needed
                    let dateStr = order.date;
                    if (order.date && !isNaN(order.date)) {
                        const dateObj = new Date(order.date * 1000);
                        dateStr = dateObj.toLocaleDateString('vi-VN') + ' ' + dateObj.toLocaleTimeString('vi-VN');
                    }

                    const totalFormatted = Number(order.total || 0).toLocaleString('vi-VN') + ' VND';
                    const isPaid = order.status_label && order.status_label.toLowerCase().includes('đã thanh toán');
                    const statusColor = isPaid ? 'bg-green-100 text-green-700 border-green-200' : 'bg-yellow-100 text-yellow-700 border-yellow-200';

                    let linesHtml = '';
                    if (order.lines && Array.isArray(order.lines) && order.lines.length > 0) {
                        linesHtml = '<div class="mt-2 border-t border-gray-200 pt-4"><p class="text-sm font-semibold text-gray-700 mb-3">Sản phẩm đã mua:</p><ul class="space-y-3">';
                        order.lines.forEach(line => {
                            const productName = line.product_label || line.product_ref || line.label || line.description || 'Sản phẩm';
                            const qty = line.qty || 1;
                            const subtotal = Number(line.total_ttc || line.subprice || line.price || 0).toLocaleString('vi-VN') + ' VND';
                            linesHtml += `
                                <li class="flex justify-between items-center text-sm bg-white p-3 rounded border border-gray-100">
                                    <div>
                                        <span class="font-medium text-gray-900">${productName}</span>
                                        <span class="text-gray-500 ml-2">x${qty}</span>
                                    </div>
                                    <span class="text-gray-600 font-medium">${subtotal}</span>
                                </li>
                            `;
                        });
                        linesHtml += '</ul></div>';
                    }

                    const customerEmail = order.customer_email || email;
                    // Đặt ở đây phải không?
                    const actions = data.actions || {};
                    let payButtonHtml = '';

                    // Kiểm tra nếu được phép thanh toán và có đường link VNPay hợp lệ
                    if (actions.can_pay && actions.pay_url && actions.pay_url !== "" && actions.pay_url !== "null") {
                        payButtonHtml = `
                            <div class="mt-6 pt-4 border-t border-gray-200">
                                <a href="${actions.pay_url}" 
                                class="flex justify-center items-center w-full bg-green-600 text-white py-3 rounded-md text-sm font-medium hover:bg-green-700 transition-colors shadow-sm">
                                    Thanh toán ngay qua VNPay &rarr;
                                </a>
                            </div>
                        `;
                    } else if (isPaid) {
                        payButtonHtml = `
                            <div class="mt-6 pt-4 border-t border-gray-200">
                                <a href="/invoice/${order.id || order.ref}" target="_blank"
                                class="flex justify-center items-center w-full bg-red-700 text-white py-3 rounded-md text-sm font-medium hover:bg-red-800 transition-colors shadow-sm">
                                    Xem chi tiết hóa đơn &rarr;
                                </a>
                            </div>
                        `;
                    }
                    resContent.innerHTML = `
                        <div class="flex flex-col gap-4">
                            <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                                <span class="text-gray-500">Email khách hàng:</span>
                                <span class="font-semibold text-gray-900">${customerEmail}</span>
                            </div>
                            <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                                <span class="text-gray-500">Mã tham chiếu:</span>
                                <span class="font-semibold text-gray-900">${order.ref || order.id}</span>
                            </div>
                            <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                                <span class="text-gray-500">Ngày tạo:</span>
                                <span class="font-medium text-gray-900">${dateStr}</span>
                            </div>
                            <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                                <span class="text-gray-500">Tổng tiền:</span>
                                <span class="font-bold text-red-700 text-lg">${totalFormatted}</span>
                            </div>
                            <div class="flex justify-between items-center pt-1 pb-2">
                                <span class="text-gray-500">Trạng thái:</span>
                                <span class="px-3 py-1 rounded-full text-xs font-semibold border ${statusColor}">
                                    ${order.status_label || 'Đang xử lý'}
                                </span>
                            </div>
                            ${linesHtml}
                            ${payButtonHtml}
                        </div>
                    `;
                } else {
                    resContent.innerHTML = `<div class="text-gray-700">Không tìm thấy thông tin đơn hàng.</div>`;
                }
                resContainer.classList.remove('hidden');
            } catch (error) {
                resContent.innerHTML = `<div class="text-red-600 font-medium">Lỗi kết nối: ${error.message}</div>`;
                resContainer.classList.remove('hidden');
            } finally {
                // Khôi phục nút
                btn.disabled = false;
                icon.classList.add('hidden');
            }
        }
    </script>
</body>

</html>