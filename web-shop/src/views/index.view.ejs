<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Mua hàng WSO2</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } }
        }
    </script>
</head>

<body class="bg-gray-100 flex justify-center items-center min-h-screen font-sans text-gray-900 p-4">

    <div class="bg-white p-8 sm:p-10 rounded-xl w-full max-w-[500px]">
        <h1 class="text-2xl font-semibold mb-8 text-center tracking-tight">Giỏ hàng của bạn</h1>

        <div class="border-b border-gray-100 pb-6 mb-6 flex justify-between items-center">
            <div>
                <p class="font-medium text-lg">
                    <%= product.name %>
                </p>
                <p class="text-gray-500 text-sm mt-1">Số lượng: <%= product.qty %>
                </p>
            </div>
            <p class="font-bold text-red-700 text-xl">
                <%= product.price.toLocaleString() %> VND
            </p>
        </div>

        <form action="/checkout" method="POST" class="flex flex-col gap-6">
            <input type="hidden" name="product_id" value="<%= product.id %>">
            <input type="hidden" name="quantity" value="<%= product.qty %>">
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Họ tên khách hàng</label>
                <input type="text" name="customer_name" placeholder="Nhập họ và tên" required
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-black focus:border-black text-sm transition-colors">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                <input type="email" name="customer_email" placeholder="Nhập địa chỉ email" required
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-black focus:border-black text-sm transition-colors">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Địa chỉ giao hàng</label>
                <div class="flex flex-col gap-3">
                    <select id="provinceSelect" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-black focus:border-black text-sm transition-colors">
                        <option value="">Chọn Tỉnh/Thành phố</option>
                    </select>
                    <select id="communeSelect" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-black focus:border-black text-sm transition-colors">
                        <option value="">Chọn Phường/Xã</option>
                    </select>
                    <input type="text" id="streetInput" required placeholder="Số nhà/Tên đường" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-black focus:border-black text-sm transition-colors">
                    <input type="hidden" name="address" id="full_address">
                </div>
            </div>

            <button type="submit" class="w-full bg-red-700 text-white py-3 rounded-md text-sm font-medium hover:bg-red-800 transition-colors mt-2">
                Thanh toán VNPAY ngay
            </button>
            
            <a href="/" class="text-center text-sm font-medium text-gray-500 hover:text-red-700 transition-colors mt-2">
                &larr; Quay lại cửa hàng
            </a>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const provinceSelect = document.getElementById('provinceSelect');
            const communeSelect = document.getElementById('communeSelect');
            const streetInput = document.getElementById('streetInput');
            const fullAddressInput = document.getElementById('full_address');

            axios.get('https://production.cas.so/address-kit/2025-07-01/provinces')
                .then(response => {
                    const provinces = response.data.provinces;
                    provinces.forEach(p => {
                        const option = document.createElement('option');
                        option.value = p.code;
                        option.textContent = p.name;
                        provinceSelect.appendChild(option);
                    });
                })
                .catch(err => console.error('Lỗi khi lấy danh sách tỉnh/thành:', err));

            provinceSelect.addEventListener('change', (e) => {
                const provinceCode = e.target.value;
                communeSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
                if (provinceCode) {
                    axios.get(`https://production.cas.so/address-kit/2025-07-01/provinces/${provinceCode}/communes`)
                        .then(response => {
                            const communes = response.data.communes;
                            communes.forEach(c => {
                                const option = document.createElement('option');
                                option.value = c.code;
                                option.textContent = c.name;
                                communeSelect.appendChild(option);
                            });
                        })
                        .catch(err => console.error('Lỗi khi lấy danh sách phường/xã:', err));
                }
                updateFullAddress();
            });

            const updateFullAddress = () => {
                const provinceName = provinceSelect.options[provinceSelect.selectedIndex]?.text || '';
                const communeName = communeSelect.options[communeSelect.selectedIndex]?.text || '';
                const streetName = streetInput.value.trim();

                const parts = [];
                if (streetName) parts.push(streetName);
                if (communeSelect.value) parts.push(communeName);
                if (provinceSelect.value) parts.push(provinceName);

                fullAddressInput.value = parts.join(', ');
            };

            communeSelect.addEventListener('change', updateFullAddress);
            streetInput.addEventListener('input', updateFullAddress);
        });
    </script>
</body>

</html>